{
  "name": "@noah/dsh-evoontology",
  "version": "0.1.0",
  "private": true,
  "description": "Self-evolving, versioned ontology layer for DSH agents, ported from ruc-datalab/EvoOntology.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills",
    "python"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
